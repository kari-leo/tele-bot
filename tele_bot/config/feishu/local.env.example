FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_ALLOWED_USER_IDS=
FEISHU_API_BASE_URL=https://open.feishu.cn
FEISHU_WEBHOOK_HOST=127.0.0.1
FEISHU_WEBHOOK_PORT=3000
FEISHU_WEBHOOK_PATH=/feishu/webhook

# Comma-separated Feishu user_id/open_id values allowed to create KB spaces.
KB_CREATOR_USER_IDS=
# Fixed Feishu user_id/open_id used by the local read-only KB MCP server.
KB_MCP_USER_ID=
