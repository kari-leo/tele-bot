FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=
# Optional. Leave empty to skip callback token checks; a configured token is validated.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# Administrators only. Explicit user_id/open_id values, comma separated.
# Empty disables access; no per-feature owner or creator lists are required.
FEISHU_ADMIN_USER_IDS=
FEISHU_API_BASE_URL=https://open.feishu.cn
FEISHU_WEBHOOK_HOST=127.0.0.1
FEISHU_WEBHOOK_PORT=3000
FEISHU_WEBHOOK_PATH=/feishu/webhook

# Optional fixed admin identity for local read-only KB MCP; defaults to the first admin.
KB_MCP_USER_ID=

# Base tools are always registered. SDK/network auth wait until first tool use.
# Set both to use a separate app; leave both empty to reuse FEISHU_APP_*.
FEISHU_BITABLE_APP_ID=
FEISHU_BITABLE_APP_SECRET=
# Optional legacy seed/alias file; Base-link discovery works without this file.
FEISHU_BITABLE_TARGETS_FILE=tele_bot/config/feishu/bitable_targets.json
FEISHU_BITABLE_SQLITE_PATH=data/bitable.sqlite
FEISHU_BITABLE_TIMEOUT_SECONDS=30
FEISHU_BITABLE_QUERY_PAGE_SIZE=50
FEISHU_BITABLE_MAX_QUERY_RECORDS=500
FEISHU_BITABLE_MAX_WRITE_RECORDS=100
FEISHU_BITABLE_CONFIRM_TTL_SECONDS=600
