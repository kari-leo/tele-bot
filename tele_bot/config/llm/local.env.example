ALIBAILIAN_API_KEY=
ALIBAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBAILIAN_MODEL=qwen-plus
ALIBAILIAN_TIMEOUT_SECONDS=60

# Knowledge-base embeddings use separate credentials and limits.
ALIBAILIAN_EMBEDDING_API_KEY=
ALIBAILIAN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBAILIAN_EMBEDDING_MODEL=text-embedding-v4
ALIBAILIAN_EMBEDDING_DIMENSIONS=1024
ALIBAILIAN_EMBEDDING_TIMEOUT_SECONDS=30
ALIBAILIAN_EMBEDDING_BATCH_SIZE=10
ALIBAILIAN_EMBEDDING_DAILY_TOKEN_BUDGET=1000000
ALIBAILIAN_EMBEDDING_DAILY_COST_BUDGET_CNY=1.0

# Project knowledge-base persistence and ingestion safety limits.
KB_SQLITE_PATH=data/knowledge.sqlite
KB_MAX_CHUNKS_PER_SPACE=10000
KB_MAX_IMPORT_BYTES=31457280
KB_INDEX_WORKER_COUNT=1

# Retrieval experiments (same settings used by /kb, main Agent and read-only MCP).
# Keep vector until a representative project evaluation supports a change.
KB_SEARCH_MODE=vector
KB_SEARCH_CANDIDATES=30
KB_SEARCH_RESULTS=5
KB_RRF_CONSTANT=60
KB_MIN_VECTOR_SCORE=-1
KB_QUERY_EXPANSION=false
KB_QUERY_MAX_EXPANSIONS=2
# Optional trusted JSON file: {"original query": ["alias query"]}.
KB_QUERY_EXPANSIONS_FILE=
KB_CHUNK_MAX_CHARS=1200
KB_CHUNK_OVERLAP_CHARS=120
KB_EMBEDDING_CONTEXT_PREFIX=false

# Local table parsing: hard failures ask the administrator to narrow/split sources.
KB_TABLE_MAX_UNPACKED_BYTES=104857600
KB_TABLE_MAX_SHEETS=32
KB_TABLE_MAX_ROWS=50000
KB_TABLE_MAX_COLUMNS=256
KB_TABLE_MAX_CELLS=500000
KB_TABLE_MAX_CELL_CHARS=100000
KB_TABLE_MAX_OUTPUT_CHARS=10000000

# Controlled local workspace and Codex execution
# Windows example: D:\\files_data\\windborne\\tele_bot
# Ubuntu example: /srv/telebot/workspace
TELE_BOT_WORKSPACE_ROOT=
# Separate entries with ; on Windows and : on Ubuntu.
TELE_BOT_ALLOWED_ROOTS=
# Keep this near the tele_bot directory for easy discovery.
# Windows example: D:\\files_data\\windborne\\tele_bot-quarantine
# Ubuntu example: /srv/telebot/tele_bot-quarantine
TELE_BOT_QUARANTINE_ROOT=
TELE_BOT_CODEX_COMMAND=codex
TELE_BOT_CODEX_MODEL=gpt-6.1-sol
# Per Codex invocation in seconds; values above 1200 are capped at 20 minutes.
TELE_BOT_CODEX_TIMEOUT=1200
# Default Codex project used when a command does not include a directory.
# Windows default: D:\\files_data\\
# Ubuntu example: /srv/telebot/workspace
TELE_BOT_CODEX_WORKSPACE_ROOT=
# Set true for a non-Git workspace such as a local job-tracking directory.
TELE_BOT_CODEX_SKIP_GIT_REPO_CHECK=true
