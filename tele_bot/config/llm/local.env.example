ALIBAILIAN_API_KEY=
ALIBAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBAILIAN_MODEL=qwen-plus
ALIBAILIAN_TIMEOUT_SECONDS=60

# Controlled local workspace and Codex execution
# Windows example: D:\\files_data\\windborne\\tele_bot
# Ubuntu example: /srv/telebot/workspace
TELE_BOT_WORKSPACE_ROOT=
# Separate entries with ; on Windows and : on Ubuntu.
TELE_BOT_ALLOWED_ROOTS=
# Keep this near the tele_bot directory for easy discovery.
# Windows example: D:\\files_data\\windborne\\tele_bot-quarantine
# Ubuntu example: /srv/telebot/tele_bot-quarantine
TELE_BOT_QUARANTINE_ROOT=
TELE_BOT_CODEX_COMMAND=codex
TELE_BOT_CODEX_TIMEOUT=600
# Set true for a non-Git workspace such as a local job-tracking directory.
TELE_BOT_CODEX_SKIP_GIT_REPO_CHECK=true
